PORT=3000
DATABASE_URL=

# Cognitive role routing. Every role has an explicit primary and fallback provider/model.
# Supported providers: OPENAI, GROK, KIMI
WORKHORSE_PROVIDER=
WORKHORSE_MODEL=
WORKHORSE_FALLBACK_PROVIDER=
WORKHORSE_FALLBACK_MODEL=

REASONER_PROVIDER=
REASONER_MODEL=
REASONER_FALLBACK_PROVIDER=
REASONER_FALLBACK_MODEL=

QUALITY_CHECKER_PROVIDER=
QUALITY_CHECKER_MODEL=
QUALITY_CHECKER_FALLBACK_PROVIDER=
QUALITY_CHECKER_FALLBACK_MODEL=

# Provider credentials.
# GROK accepts either GROK_API_KEY or XAI_API_KEY.
# KIMI accepts either KIMI_API_KEY or MOONSHOT_API_KEY.
OPENAI_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=

# Optional endpoint overrides. Safe official defaults exist in code.
OPENAI_BASE_URL=https://api.openai.com/v1
GROK_BASE_URL=https://api.x.ai/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Model execution controls
MODEL_REQUEST_TIMEOUT_MS=360000
MODEL_MAX_RETRIES=2

# Final artifact destination configuration
ARTIFACT_STORE_PROVIDER=vercel
ARTIFACT_STORE_BASE_PATH=ai-governance-kb
BLOB_READ_WRITE_TOKEN=
