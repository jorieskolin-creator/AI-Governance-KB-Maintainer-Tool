PORT=3000
DATABASE_URL=

# Optional server-side operator token for /creator and /api/creator/* routes.
CREATOR_OPERATOR_TOKEN=

# Source Register HTTPS acquisition and live LLM authoring (enabled by default in server mode unless set to false).
CREATOR_ALLOW_LIVE_SOURCE_FETCH=true
CREATOR_ALLOW_LIVE_AUTHORING=true

# Cognitive role routing. Every role has an explicit primary and cross-provider fallback model.
# Canonical provider values: OPENAI, ANTHROPIC, GROK (alias: XAI -> GROK).
# Built-in accuracy-first defaults are applied automatically when unset:
# - WORKHORSE (Pair Authoring): ANTHROPIC / claude-sonnet-5-5 -> fallback OPENAI / gpt-6.1-terra (reasoning: high)
# - QUALITY_CHECKER (Semantic QC): GROK / grok-4.7 -> fallback OPENAI / gpt-6.1-terra (reasoning: low for Grok 4.7, medium for fallback)
# - REASONER (Targeted Section Repair): OPENAI / gpt-6.1-terra -> fallback ANTHROPIC / claude-sonnet-5-5 (reasoning: high)
WORKHORSE_PROVIDER=ANTHROPIC
WORKHORSE_MODEL=claude-sonnet-5-5
WORKHORSE_FALLBACK_PROVIDER=OPENAI
WORKHORSE_FALLBACK_MODEL=gpt-6.1-terra
WORKHORSE_REASONING_EFFORT=high

QUALITY_CHECKER_PROVIDER=GROK
QUALITY_CHECKER_MODEL=grok-4.7
QUALITY_CHECKER_FALLBACK_PROVIDER=OPENAI
QUALITY_CHECKER_FALLBACK_MODEL=gpt-6.1-terra
QUALITY_CHECKER_REASONING_EFFORT=low

REASONER_PROVIDER=OPENAI
REASONER_MODEL=gpt-6.1-terra
REASONER_FALLBACK_PROVIDER=ANTHROPIC
REASONER_FALLBACK_MODEL=claude-sonnet-5-5
REASONER_REASONING_EFFORT=high

# Provider credentials.
# GROK accepts either XAI_API_KEY or GROK_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_API_KEY=

# Optional endpoint overrides. Safe official defaults exist in code.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GROK_BASE_URL=https://api.x.ai/v1

# Model execution controls
MODEL_REQUEST_TIMEOUT_MS=360000
MODEL_MAX_RETRIES=2
