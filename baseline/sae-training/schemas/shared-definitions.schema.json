{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-governance:schema:shared-definitions:2.1.0",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-F][1-5]$"
    },
    "antipatternId": {
      "type": "string",
      "pattern": "^AP-[A-F][1-5]$"
    },
    "lifecycleStage": {
      "type": "string",
      "enum": [
        "QUALIFICATION_AND_REGISTRATION",
        "DESIGN_AND_DEVELOPMENT",
        "VERIFICATION_AND_VALIDATION",
        "DEPLOYMENT",
        "OPERATION_AND_MONITORING",
        "REVIEW_AND_EVALUATION",
        "RETIREMENT"
      ]
    },
    "releaseStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "APPROVED",
        "FROZEN",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "applicabilityState": {
      "type": "string",
      "enum": [
        "APPLICABLE",
        "CONDITIONALLY_APPLICABLE",
        "NOT_APPLICABLE",
        "UNDETERMINED"
      ]
    },
    "capabilityConclusion": {
      "type": "string",
      "enum": [
        "SATISFIED",
        "PARTIALLY_SATISFIED",
        "NOT_SATISFIED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "antipatternConclusion": {
      "type": "string",
      "enum": [
        "CONFIRMED_PRESENT",
        "PARTIALLY_PRESENT",
        "TESTED_ABSENT",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "coverageState": {
      "type": "string",
      "enum": [
        "ASSESSED",
        "UNKNOWN",
        "NOT_APPLICABLE",
        "FAILED",
        "HUMAN_INTERPRETATION_REQUIRED"
      ]
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "CONFLICTING",
        "NOT_VERIFIABLE"
      ]
    },
    "technicalAssurance": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "DECLARED",
        "IMPLEMENTED",
        "TESTED",
        "OPERATIONALLY_OBSERVED",
        "NOT_APPLICABLE"
      ]
    },
    "humanAssurance": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "HUMAN_VALIDATED",
        "FORMALLY_APPROVED",
        "NOT_APPLICABLE"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKING",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFORMATIONAL"
      ]
    },
    "approvalRecord": {
      "type": "object",
      "required": [
        "approval_status",
        "approval_scope",
        "approved_by_role",
        "approved_on",
        "effective_from",
        "release_version",
        "authority_statement",
        "change_control"
      ],
      "properties": {
        "approval_status": {
          "enum": [
            "APPROVED",
            "FROZEN"
          ]
        },
        "approval_scope": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_role": {
          "type": "string",
          "minLength": 1
        },
        "approved_on": {
          "$ref": "#/$defs/date"
        },
        "effective_from": {
          "$ref": "#/$defs/date"
        },
        "review_due_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_version": {
          "$ref": "#/$defs/semver"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_statement": {
          "type": "string",
          "minLength": 1
        },
        "change_control": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(AP-)?[A-F][1-5]-Q[1-3]$"
        },
        "dimension": {
          "enum": [
            "DEFINITION_AND_INTENT",
            "IMPLEMENTATION_AND_OPERATION",
            "EVIDENCE_AND_EFFECTIVENESS"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": [
        "statement",
        "conditions",
        "exclusions",
        "reassessment_triggers"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reassessment_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evidenceRequirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "claim_supported",
        "evidence_class",
        "minimum_technical_assurance",
        "required_human_assurance",
        "acceptance_conditions",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-(AP-)?[A-F][1-5]-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "claim_supported": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "DOCUMENT",
            "IMPLEMENTATION",
            "CONFIGURATION",
            "TEST_RESULT",
            "OPERATIONAL_RECORD",
            "HUMAN_DECISION",
            "EXTERNAL_ATTESTATION"
          ]
        },
        "minimum_technical_assurance": {
          "$ref": "#/$defs/technicalAssurance"
        },
        "required_human_assurance": {
          "$ref": "#/$defs/humanAssurance"
        },
        "acceptance_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidenceRules": {
      "type": "object",
      "required": [
        "evidence_ceilings",
        "false_positive_guards",
        "prohibited_inferences",
        "contradiction_handling",
        "freshness_rules"
      ],
      "properties": {
        "evidence_ceilings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "false_positive_guards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prohibited_inferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contradiction_handling": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "freshness_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "eligible_conclusion_states",
        "mapped_atomic_item_ids",
        "required_evidence_ids",
        "default_severity",
        "lifecycle_consequence",
        "human_lock_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FND-(AP-)?[A-F][1-5]-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "eligible_conclusion_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "mapped_atomic_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-(AP-)?[A-F][1-5]-[0-9]{3}$"
          }
        },
        "default_severity": {
          "$ref": "#/$defs/severity"
        },
        "lifecycle_consequence": {
          "type": "string",
          "minLength": 1
        },
        "human_lock_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "sourceMapping": {
      "type": "object",
      "required": [
        "mapping_id",
        "source_id",
        "source_version_or_date",
        "exact_locator",
        "relationship",
        "category_rationale",
        "verification_status",
        "last_verified_date"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "pattern": "^SRCMAP-(AP-)?[A-F][1-5]-[A-Z0-9-]+-[0-9]{3}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "source_version_or_date": {
          "type": "string",
          "minLength": 1
        },
        "exact_locator": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "BINDING_LAW_WHEN_APPLICABLE",
            "OFFICIAL_REGULATORY_GUIDANCE",
            "PUBLISHED_STANDARD",
            "STANDARD_UNDER_DEVELOPMENT",
            "INFORMATIVE_METADATA_ONLY",
            "AUTHORITATIVE_VOLUNTARY_GUIDANCE",
            "GOVERNMENT_TECHNICAL_GUIDANCE",
            "AGENCY_GUIDANCE",
            "COMMUNITY_TECHNICAL_PRACTICE"
          ]
        },
        "category_rationale": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "NOT_VERIFIED",
            "RETIRED"
          ]
        },
        "last_verified_date": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": false
    },
    "tacticRef": {
      "type": "object",
      "required": [
        "mapping_id",
        "tactic_id",
        "tactic_version",
        "finding_id",
        "relationship",
        "mapping_status",
        "catalog_version"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "tactic_id": {
          "type": "string",
          "pattern": "^GOV-[A-Z]{3}-[0-9]{3}$"
        },
        "tactic_version": {
          "$ref": "#/$defs/semver"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^FND-(AP-)?[A-F][1-5]-[0-9]{3}$"
        },
        "relationship": {
          "const": "REMEDIATES"
        },
        "mapping_status": {
          "enum": [
            "APPROVED",
            "SUSPENDED",
            "RETIRED"
          ]
        },
        "catalog_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "additionalProperties": false
    },
    "runtimeBoundary": {
      "type": "object",
      "required": [
        "machine_may",
        "machine_must_not",
        "human_authority_required_for"
      ],
      "properties": {
        "machine_may": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "machine_must_not": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "human_authority_required_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
