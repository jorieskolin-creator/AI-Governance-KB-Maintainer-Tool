{
  "version": "1.0.1",
  "purpose": "Define exactly one decision authority and one canonical materializer for every governed canonical field family before SIR refactoring.",
  "principles": [
    "GenAI owns semantic meaning only where interpretation is required.",
    "The deterministic Authoring Plan owns values known from governed context before semantic authoring.",
    "The canonical compiler owns canonical identity, field placement and reference serialization.",
    "Deterministic derivation may materialize only relationships or values mechanically implied by governed inputs or already-decided semantic relationships.",
    "External human approval is the only authority for approval facts.",
    "Release state and public version materialization are owned by the release system.",
    "No canonical identity may originate from model output.",
    "The compiler must not invent a semantic relationship that is absent from SIR unless a normative contract mandates that relationship."
  ],
  "decision_authorities": ["AUTHORING_PLAN","GENAI_SEMANTIC","DETERMINISTIC_DERIVED","EXTERNAL_HUMAN","RELEASE_SYSTEM"],
  "materializers": ["CANONICAL_COMPILER","RELEASE_FINALIZER"],
